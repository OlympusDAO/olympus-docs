{
  "name": "olympus-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build:contracts": "./contracts.sh",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "test": "node --test 'scripts/*.test.mjs'",
    "format": "biome format --write . && rumdl fmt .",
    "format:check": "biome format . && rumdl fmt --check .",
    "lint": "biome check --write . && rumdl check --fix .",
    "lint:check": "biome ci . && rumdl check ."
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-common": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@heroicons/react": "^2.2.0",
    "@mdx-js/react": "^3.1.1",
    "mermaid": "11.17.2",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "katex": "^0.19.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/theme-classic": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/node": "^24.13.3",
    "rumdl": "0.3.0",
    "typescript": "^5.9.3",
    "@docusaurus/tsconfig": "3.10.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.28.10 <12",
    "npm": "use-pnpm",
    "yarn": "use-pnpm"
  },
  "packageManager": "pnpm@11.28.10"
}
